---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroIA from '../components/sections/ia/HeroIA.astro';
import LogoBar from '../components/sections/ia/LogoBar.astro';
import ProblemIA from '../components/sections/ia/ProblemIA.astro';
import ExpertisesGrid from '../components/sections/ia/ExpertisesGrid.astro';
import MethodeSection from '../components/sections/ia/MethodeSection.astro';
import CaseStudiesFeatured from '../components/sections/ia/CaseStudiesFeatured.astro';
import TestimonialsIA from '../components/sections/ia/TestimonialsIA.astro';
import StackSection from '../components/sections/ia/StackSection.astro';
import HistoricBranchBanner from '../components/sections/ia/HistoricBranchBanner.astro';
import FinalCTA from '../components/sections/ia/FinalCTA.astro';
import { SITE_DESCRIPTION } from '../config';
---

<BaseLayout
  title="Make It Global — Agence d'implémentation IA pour PME et ETI"
  description={SITE_DESCRIPTION}
>
  <main id="main-content">
    <HeroIA />
    <LogoBar />
    <ProblemIA />
    <ExpertisesGrid />
    <MethodeSection />
    <CaseStudiesFeatured />
    <TestimonialsIA />
    <StackSection />
    <HistoricBranchBanner />
    <FinalCTA />
  </main>
</BaseLayout>
