---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DottedBg from '../../components/ui/DottedBg.astro';
import { BOOKING_URL } from '../../config';

const cases = (await getCollection('caseStudies'))
  .filter((c) => !c.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout
  title="Cas clients — Make It Global"
  description="Études de cas concrètes : agents IA, outils métier sur-mesure, SEO programmatique, automatisations. Résultats mesurés pour PME et ETI."
>
  <main id="main-content">
    <section class="relative overflow-hidden pt-20 pb-16">
      <DottedBg variant="grid" />
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="badge">Cas clients</span>
        <h1 class="mt-6 text-5xl sm:text-6xl font-bold tracking-tight text-text-primary leading-[1.05]">
          Des projets qui <span class="gradient-text-accent">rapportent.</span>
        </h1>
        <p class="mt-6 text-lg text-text-muted max-w-2xl mx-auto">
          Chiffres réels, contextes réels, méthodes documentées. Ce qu'on a livré à nos clients, et ce qu'ils en retirent concrètement.
        </p>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal-children="120">
        {cases.map((c) => (
          <a href={`/cas-clients/${c.slug}/`} class="card card-glow p-8 group block" data-reveal="fade-up">
            <span class="badge badge-primary text-[10px]">{c.data.sector}</span>
            <h2 class="mt-5 text-xl font-semibold text-text-primary tracking-tight leading-snug">{c.data.title}</h2>
            <p class="mt-3 text-sm text-text-muted leading-relaxed">{c.data.description}</p>
            <div class="mt-6 pt-6 border-t border-border-subtle grid grid-cols-2 gap-4">
              {c.data.metrics.slice(0, 2).map((m) => (
                <div>
                  <div class="text-2xl font-bold gradient-text-accent tracking-tight">{m.value}</div>
                  <div class="text-[11px] text-text-muted font-mono uppercase tracking-wider">{m.label}</div>
                </div>
              ))}
            </div>
            <div class="mt-6 text-primary-400 text-sm group-hover:translate-x-0.5 transition-transform">Lire le cas →</div>
          </a>
        ))}
      </div>
    </section>

    <section class="relative py-24 border-t border-border-subtle">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl font-bold tracking-tight text-text-primary">Votre projet, le prochain cas client ?</h2>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/audit-ia/" class="btn-primary">Obtenir un audit IA</a>
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">Réserver un appel</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
