---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DottedBg from '../../components/ui/DottedBg.astro';
import { BOOKING_URL } from '../../config';

const services = [
  {
    title: 'Doublage vidéo multilingue',
    desc: "Voix off professionnelles, IA ou humaines, en 30+ langues. Synchronisation labiale, respect du ton d'origine, livraison sous 48h.",
    bullets: ['Anglais, espagnol, allemand, italien, portugais, arabe, mandarin, japonais…', 'IA premium ou comédien humain selon usage', 'Re-mix audio + export broadcast-ready'],
  },
  {
    title: 'Sous-titrage & closed captions',
    desc: "Sous-titrage forcé, SRT, VTT, closed captions pour plateformes (YouTube, Vimeo, LinkedIn, LMS). Timecodes précis, respect des normes d'accessibilité.",
    bullets: ['Formats SRT, VTT, SCC, STL', 'Respect WCAG et FCC', 'Traduction multilingue optionnelle'],
  },
  {
    title: 'Traduction de formations e-learning',
    desc: 'Modules Rise, Storyline, Captivate, vidéos + quiz + documents. Localisation pédagogique complète, pas seulement linguistique.',
    bullets: ['SCORM, xAPI, H5P compatibles', 'Adaptation culturelle des exemples', 'Livraison prête à intégrer dans votre LMS'],
  },
  {
    title: 'Traduction de PDFs & documentation',
    desc: 'Rapports, livres blancs, catalogues, manuels techniques, fiches produits. On préserve la mise en page exactement.',
    bullets: ['InDesign, Word, LaTeX, PDF natif', 'Glossaire métier respecté', 'Relecture par expert sectoriel'],
  },
  {
    title: 'Localisation de sites web',
    desc: "Traduction + SEO multilingue + adaptation hreflang + intégration dans votre CMS. WordPress, Shopify, Webflow, headless — tout passe.",
    bullets: ['SEO international inclus', 'Gestion hreflang et balises canoniques', 'Mise à jour continue si besoin'],
  },
  {
    title: 'Content & marketing localisation',
    desc: 'Landing pages, emails, posts LinkedIn, newsletters, fiches produits e-commerce. Transcréation pour garder la punchline, pas juste la grammaire.',
    bullets: ['Transcréation (pas juste traduction)', 'Tests A/B multilingues', 'Adaptation aux marchés cibles'],
  },
];

const markets = [
  { region: 'Anglophone', langs: 'EN-US, EN-UK, EN-CA, EN-AU' },
  { region: 'Hispanophone', langs: 'ES-ES, ES-MX, ES-LATAM' },
  { region: 'Germanique', langs: 'DE, NL, SV, DA, NO' },
  { region: 'Romanophone', langs: 'FR, IT, PT-BR, PT-PT, RO' },
  { region: 'Asie', langs: 'ZH, JA, KO, TH, VI, ID' },
  { region: 'MENA', langs: 'AR, HE, FA, TR' },
];
---

<BaseLayout
  title="Services de traduction & localisation — Make It Global"
  description="Doublage vidéo, sous-titrage, traduction de formations, PDFs, sites web et contenus marketing. Service clé-en-main en 30+ langues, livraison sous 48h."
>
  <main id="main-content">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-28 sm:pb-24">
      <DottedBg variant="grid" />
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <a href="/traduction/" class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-text-primary transition-colors">
          ← Retour à Traduction
        </a>
        <div class="mt-8 max-w-3xl" data-reveal="fade-up">
          <span class="badge badge-primary">Branche historique · Traduction</span>
          <h1 class="mt-6 text-5xl sm:text-6xl font-bold tracking-tight text-text-primary leading-[1.05]">
            Tous nos services<br />
            <span class="gradient-text">de localisation.</span>
          </h1>
          <p class="mt-6 text-lg sm:text-xl text-text-muted max-w-2xl leading-relaxed">
            Du doublage vidéo à la localisation de sites web, en passant par les formations e-learning et les campagnes marketing. 10 ans d'expertise, 30+ langues, livraison sous 48h sur les urgences.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">Demander un devis</a>
            <a href="/blog/localisation/" class="btn-secondary">Explorer le blog</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Services grid -->
    <section class="relative py-20 border-t border-border-subtle">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-14" data-reveal="fade-up">
          <span class="badge">Nos 6 services</span>
          <h2 class="mt-6 text-4xl font-bold tracking-tight text-text-primary">Ce qu'on fait exactement.</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-children="120">
          {services.map((s, i) => (
            <div class="card p-7 flex flex-col h-full" data-reveal="fade-up">
              <div class="font-mono text-xs text-primary-400">{String(i + 1).padStart(2, '0')}</div>
              <h3 class="mt-4 text-xl font-semibold text-text-primary tracking-tight">{s.title}</h3>
              <p class="mt-3 text-sm text-text-muted leading-relaxed">{s.desc}</p>
              <ul class="mt-5 space-y-2">
                {s.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-xs text-text-secondary">
                    <span class="text-accent-500 mt-1">▸</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Markets -->
    <section class="relative py-20 border-t border-border-subtle bg-bg-surface/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12" data-reveal="fade-up">
          <span class="badge">Couverture</span>
          <h2 class="mt-6 text-4xl font-bold tracking-tight text-text-primary">30+ langues, 6 zones géographiques.</h2>
          <p class="mt-4 text-text-muted">Des comédiens natifs, des relecteurs experts sectoriels et une équipe de chef de projet dédiée.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4" data-reveal-children="80">
          {markets.map((m) => (
            <div class="card p-5" data-reveal="fade-up">
              <div class="text-sm font-semibold text-text-primary">{m.region}</div>
              <div class="mt-2 text-xs font-mono text-text-muted">{m.langs}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative py-24 border-t border-border-subtle">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl sm:text-5xl font-bold tracking-tight text-text-primary" data-reveal="fade-up">
          Un projet de localisation ?
        </h2>
        <p class="mt-6 text-lg text-text-muted" data-reveal="fade-up" data-reveal-delay="100">
          Devis sous 24h, livraison sous 48h sur les urgences. On gère tout de A à Z.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3" data-reveal="fade-up" data-reveal-delay="200">
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">Réserver un appel</a>
          <a href="/traduction/" class="btn-secondary">Voir la page branche</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
