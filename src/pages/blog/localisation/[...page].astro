---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import Pagination from '../../../components/blog/Pagination.astro';
import { BLOG_PAGE_SIZE, BLOG_LOCALISATION_TITLE, BLOG_LOCALISATION_DESCRIPTION, CATEGORY_LABELS } from '../../../config';
import { sortPostsByDate, filterPublishedPosts } from '../../../utils/blog';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('blog');
  const localisationPosts = sortPostsByDate(
    filterPublishedPosts(allPosts).filter((p) => p.data.section === 'localisation')
  );
  return paginate(localisationPosts, { pageSize: BLOG_PAGE_SIZE });
};

const { page } = Astro.props;

const LOCALISATION_CATEGORIES = [
  'strategie-internationale',
  'localisation-video',
  'localisation-contenu',
  'croissance-b2b',
  'guides-sectoriels',
  'seo-international',
  'outils-et-ressources',
];
const categories = LOCALISATION_CATEGORIES.map((slug) => [slug, CATEGORY_LABELS[slug]] as const);
---

<BaseLayout title={BLOG_LOCALISATION_TITLE} description={BLOG_LOCALISATION_DESCRIPTION}>
  <main id="main-content">
    <section class="relative overflow-hidden pt-20 pb-16">
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="badge">Blog Localisation · Archives</span>
        <h1 class="mt-6 text-5xl sm:text-6xl font-bold tracking-tight text-text-primary leading-[1.05]">
          Traduction &amp; <span class="gradient-text">internationalisation.</span>
        </h1>
        <p class="mt-6 text-lg text-text-muted max-w-2xl mx-auto">
          Notre archive historique : conseils d'expansion internationale, localisation vidéo, SEO multilingue. Issue de notre métier d'origine.
        </p>
        <div class="mt-6 text-sm text-text-dim">
          Vous cherchez nos contenus IA ? → <a href="/blog/" class="text-primary-400 hover:text-primary-300 underline">Blog IA</a>
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <nav class="flex flex-wrap gap-2 mb-10 justify-center" aria-label="Filtrer par catégorie">
        <a href="/blog/localisation/" class="badge badge-primary">Tous</a>
        {categories.map(([slug, label]) => (
          <a href={`/blog/categorie/${slug}/`} class="badge hover:text-text-primary transition-colors">{label}</a>
        ))}
      </nav>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {page.data.map((post) => <PostCard post={post} />)}
      </div>

      <Pagination currentPage={page.currentPage} totalPages={page.lastPage} baseUrl="/blog/localisation/" />
    </section>
  </main>
</BaseLayout>
