---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const deliverables = [
  { title: "Interface web sur-mesure", desc: "Application interne construite avec Next.js, Supabase, déployée sur Vercel. Rapide, moderne, sécurisée." },
  { title: "IA intégrée là où elle compte", desc: "Classification, résumé, génération de contenu, extraction d'info. Chaque LLM bien placé dans le workflow." },
  { title: "Authentification & rôles", desc: "SSO, rôles, permissions, logs d'audit. Conforme aux exigences entreprise." },
  { title: "Intégrations avec vos outils", desc: "Connecté à HubSpot, Slack, Notion, Airtable, Google Workspace, votre ERP..." },
  { title: "Documentation & formation", desc: "Guide utilisateur, vidéos de formation, session de prise en main avec vos équipes." },
  { title: "Évolutions continues", desc: "On itère avec vous pendant 3 mois post-livraison pour peaufiner selon les usages réels." },
];

const process = [
  { n: '01', title: 'User research', desc: "On observe vos équipes utiliser leurs outils actuels. On identifie les vraies frictions." },
  { n: '02', title: 'Design & specs', desc: "Maquettes cliquables, validation du parcours, specs techniques détaillées." },
  { n: '03', title: 'Build', desc: "Développement itératif en 4-8 semaines. Démos hebdo pour garder le cap." },
  { n: '04', title: 'Rollout', desc: "Déploiement progressif, formation, support. On reste sur le pont." },
];

const faqs = [
  { q: "Pourquoi développer un outil sur-mesure plutôt qu'utiliser un SaaS existant ?", a: "Parce que votre métier est unique. Les SaaS génériques vous forcent à adapter vos process à leur logique, pas l'inverse. Un outil sur-mesure modélise exactement votre workflow réel." },
  { q: "Combien ça coûte ?", a: "La plupart de nos outils métier démarrent à 18k€ pour une v1 opérationnelle (4 semaines). Les projets plus complexes montent à 45-60k€." },
  { q: "Qui possède le code ?", a: "Vous. Code source livré, documentation technique, aucun verrouillage propriétaire." },
  { q: "Vous faites aussi la maintenance ?", a: "Oui, via un contrat mensuel léger ou au ticket selon vos besoins. Vous pouvez aussi reprendre en interne à tout moment." },
];
---

<ServiceLayout
  title="Outils métier sur-mesure boostés à l'IA — Make It Global"
  description="Applications internes sur-mesure avec IA intégrée. Next.js, Supabase, LLMs. Modélise exactement votre métier, pas l'inverse."
  kicker="Service 02 · Outils métier"
  headline="Des outils internes qui parlent votre métier."
  subheadline="Fini les SaaS qui ne collent pas. On développe des interfaces internes sur-mesure, avec l'IA aux bons endroits du workflow. Rapide, maintenable, à votre image."
  deliverables={deliverables}
  process={process}
  faqs={faqs}
  relatedCase={{ slug: 'outil-metier-devis-sur-mesure', title: "Outil de devis sur-mesure avec IA — 4 jours → 20 minutes", metric: '4j → 20min' }}
/>
