---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const deliverables = [
  { title: "Workflows n8n / Make", desc: "Automatisations robustes, auto-hébergées ou cloud. Versionnées, monitorées, documentées." },
  { title: "Custom scripts + cron", desc: "Pour ce qui ne passe pas par no-code. Node.js / Python, hébergés sur votre infra." },
  { title: "Intégrations API", desc: "Connexion entre vos outils (CRM, ERP, comptabilité, marketing). Sync bidirectionnelle fiable." },
  { title: "AI-powered steps", desc: "LLMs intégrés dans les workflows : classification, extraction, reformulation, routage intelligent." },
  { title: "Alerting & error handling", desc: "Notifications Slack / email sur erreur, retry automatique, fallback manuel quand nécessaire." },
  { title: "Documentation vivante", desc: "Chaque workflow est documenté : schéma, dépendances, coût, owner." },
];

const process = [
  { n: '01', title: 'Audit workflows', desc: "Inventaire des process manuels à automatiser, priorisation ROI." },
  { n: '02', title: 'Cartographie', desc: "Schéma de chaque automatisation avant de coder. Validation avec vous." },
  { n: '03', title: 'Build & test', desc: "Développement itératif, tests sur données réelles, déploiement progressif." },
  { n: '04', title: 'Handover', desc: "Vous avez accès à tout, formation pour maintenir en interne si souhaité." },
];

const faqs = [
  { q: "n8n ou Make ou code custom ?", a: "On choisit selon le cas. n8n pour les workflows complexes et auto-hébergeables. Make pour les intégrations SaaS rapides. Code custom quand la logique dépasse les capacités no-code ou que la performance compte." },
  { q: "Qui maintient les automatisations après livraison ?", a: "Au choix : vous reprenez la main (formation incluse), on reste en support (contrat mensuel), ou mix des deux. Les workflows sont documentés pour être maintenables par n'importe quel dev." },
  { q: "Combien ça coûte ?", a: "Un workflow simple : 800-2k€. Un package de 5-10 workflows critiques : 8-20k€. Maintenance : 300-800€/mois selon le volume." },
  { q: "Vous gérez les intégrations avec notre ERP legacy ?", a: "Oui, si l'ERP expose une API (REST, SOAP, ou même base de données directe). Sinon on peut passer par RPA headless ou webhooks." },
];
---

<ServiceLayout
  title="Automatisations métier — n8n, Make, custom — Make It Global"
  description="Workflows automatisés qui font le travail répétitif à votre place. n8n, Make, scripts custom, LLMs intégrés. Robuste, documenté, monitoré."
  kicker="Service 04 · Automatisations"
  headline="Le travail répétitif n'existe plus."
  subheadline="On identifie les process qui saignent du temps et on les automatise avec n8n, Make ou du code custom. Avec l'IA intégrée là où elle apporte un vrai gain."
  deliverables={deliverables}
  process={process}
  faqs={faqs}
  relatedCase={{ slug: 'outil-metier-devis-sur-mesure', title: "Devis automatisés avec IA — 4 jours à 20 minutes", metric: '-96%' }}
/>
