---
import ServiceLayout from '../../layouts/ServiceLayout.astro';

const deliverables = [
  { title: "Cartographie des cas d'usage", desc: "Audit de vos process métier, identification des leviers IA à plus fort ROI, priorisation." },
  { title: "Roadmap 3-6-12 mois", desc: "Un plan de bataille clair, avec jalons, budgets, métriques de succès." },
  { title: "Architecture technique", desc: "Stack, intégrations, choix des modèles, infra. Prête à être exécutée." },
  { title: "PoC fonctionnel", desc: "Un prototype opérationnel sur le cas d'usage n°1, testé en conditions réelles." },
  { title: "Déploiement production", desc: "Mise en prod, monitoring, documentation, formation de vos équipes." },
  { title: "Maintien en condition", desc: "Support, évolutions, SLA. On reste disponibles après la livraison." },
];

const process = [
  { n: '01', title: 'Audit (1 semaine)', desc: "Interviews équipes, analyse data, identification des quick wins." },
  { n: '02', title: 'Cadrage (3-5 jours)', desc: "Roadmap validée avec vous. Budgets, délais, priorités claires." },
  { n: '03', title: 'PoC (2 semaines)', desc: "On prouve que ça marche sur le cas n°1 avant d'investir dans la suite." },
  { n: '04', title: 'Production (4-8 sem.)', desc: "Développement, intégrations, mise en prod, formation, run." },
];

const faqs = [
  { q: "Combien coûte une implémentation IA complète ?", a: "Cela dépend du périmètre, mais la plupart de nos missions démarrent entre 15k€ (un cas d'usage simple) et 80k€ (transformation multi-process). L'audit initial est toujours gratuit pour cadrer." },
  { q: "Combien de temps avant de voir du ROI ?", a: "Notre engagement : premier impact mesurable en 2 semaines (PoC), ROI net sur investissement en 3 à 6 mois selon la complexité." },
  { q: "On a déjà des outils internes, vous partez de zéro ?", a: "Non, on part de votre existant. On intègre l'IA dans vos outils actuels (HubSpot, Notion, Airtable, outils maison) plutôt que de tout reconstruire." },
  { q: "Vous formez nos équipes ?", a: "Oui. Chaque livraison inclut une formation, une documentation claire, et un support post-livraison. Vous devez être autonome sur ce qu'on vous livre." },
];
---

<ServiceLayout
  title="Implémentation IA en entreprise — Make It Global"
  description="De l'audit au déploiement en production, nous implémentons l'IA dans votre entreprise. Stratégie, PoC en 2 semaines, mise en prod, formation."
  kicker="Service 01 · Implémentation IA"
  headline="On implémente l'IA dans votre entreprise. Vraiment."
  subheadline="Pas de slides. On audite vos process, on prouve la valeur en 2 semaines avec un PoC, puis on déploie en production. Méthode, budget et livrables clairs."
  deliverables={deliverables}
  process={process}
  faqs={faqs}
  relatedCase={{ slug: 'agent-qualification-leads', title: "Agent de qualification de leads — 78% de leads qualifiés auto, 22h/semaine économisées", metric: '-22h/sem' }}
/>
