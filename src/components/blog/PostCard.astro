---
import type { CollectionEntry } from 'astro:content';
import { formatDate, getReadingTime, getCategorySection } from '../../utils/blog';
import { CATEGORY_LABELS } from '../../config';
import CategoryBadge from './CategoryBadge.astro';
import BlogImage from './BlogImage.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  showSectionBadge?: boolean;
}

const { post, showSectionBadge = false } = Astro.props;
const { title, description, publishDate, category, image } = post.data;
const section = getCategorySection(category);
const sectionLabel = section === 'ia' ? 'Blog IA' : 'Blog Localisation';
---

<article class="group rounded-2xl overflow-hidden bg-surface-white border border-neutral-200 card-hover">
  <a href={`/blog/${post.slug}/`} class="block">
    <div class="aspect-[16/9] overflow-hidden">
      <BlogImage
        title={title}
        category={category}
        alt={image.alt}
        class="w-full h-full transition-transform duration-500 group-hover:scale-105"
      />
    </div>
    <div class="p-5">
      <div class="flex items-center gap-3 mb-3 flex-wrap">
        <CategoryBadge category={category} />
        {showSectionBadge && (
          <span class={`text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-full border ${section === 'ia' ? 'text-primary-400 border-primary-500/40' : 'text-text-muted border-border-subtle'}`}>
            {sectionLabel}
          </span>
        )}
        <time datetime={publishDate.toISOString()} class="text-xs text-text-muted">
          {formatDate(publishDate)}
        </time>
      </div>
      <h3 class="text-lg font-semibold text-text-heading mb-2 line-clamp-2 group-hover:text-primary-500 transition-colors">
        {title}
      </h3>
      <p class="text-sm text-text-muted line-clamp-2">
        {description}
      </p>
    </div>
  </a>
</article>
