---
import { NAV_SERVICES } from '../../../config';

const icons: Record<string, string> = {
  '/services/implementation-ia':   'M4 4h16v16H4z M4 12h16 M12 4v16',
  '/services/outils-metier':       'M3 5h18v14H3z M7 9h10 M7 13h6',
  '/services/saas-agents-ia':      'M12 2v4 M12 18v4 M4 12H2 M22 12h-2 M19 5l-2 2 M5 5l2 2 M5 19l2-2 M19 19l-2-2 M12 8a4 4 0 100 8 4 4 0 000-8z',
  '/services/automatisations':     'M4 7h16 M4 12h10 M4 17h16 M20 7l-3 3 3 3 M14 12l3 3-3 3',
  '/services/seo-automatise':      'M11 4a7 7 0 107 7 M21 21l-4.35-4.35 M11 8v3l2 2',
};

const details: Record<string, { tags: string[]; outcome: string }> = {
  '/services/implementation-ia': {
    tags: ['Stratégie', 'Déploiement', 'Change management'],
    outcome: 'De zéro à prod en 3 mois',
  },
  '/services/outils-metier': {
    tags: ['Next.js', 'Supabase', 'LLM'],
    outcome: 'Interfaces internes dopées à l\'IA',
  },
  '/services/saas-agents-ia': {
    tags: ['LangChain', 'Claude', 'OpenAI'],
    outcome: 'Agents autonomes en production',
  },
  '/services/automatisations': {
    tags: ['n8n', 'Make', 'Custom'],
    outcome: 'Workflows qui tournent 24/7',
  },
  '/services/seo-automatise': {
    tags: ['Content IA', 'Programmatic', 'Embeddings'],
    outcome: 'Trafic organique x3 à 12 mois',
  },
};
---

<section class="relative py-24 sm:py-32" id="expertises">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-16">
      <div class="max-w-2xl" data-reveal="fade-up">
        <span class="badge">02 · Ce qu'on fait</span>
        <h2 class="mt-6 text-4xl sm:text-5xl font-bold tracking-tight text-text-primary">
          Cinq leviers IA,<br />
          <span class="gradient-text">une seule équipe.</span>
        </h2>
      </div>
      <p class="max-w-md text-text-muted" data-reveal="fade-up" data-reveal-delay="100">
        On ne vend pas du "conseil IA". On code, on déploie, on maintient. Chaque mission est pilotée par un lead technique senior.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal-children="100">
      {NAV_SERVICES.map((svc, i) => (
        <a
          href={svc.href}
          class="card card-glow p-8 group relative overflow-hidden"
          data-reveal="fade-up"
        >
          <div class="absolute top-4 right-4 text-xs font-mono text-text-dim">
            0{i + 1}
          </div>
          <div class="w-12 h-12 rounded-xl border border-border bg-bg-elevated flex items-center justify-center text-primary-400 group-hover:text-primary-300 group-hover:border-primary-500/40 transition-all">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[svc.href]}></path>
            </svg>
          </div>
          <h3 class="mt-6 text-xl font-semibold text-text-primary tracking-tight">{svc.label}</h3>
          <p class="mt-2 text-sm text-text-muted leading-relaxed">{svc.description}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {details[svc.href].tags.map((tag) => (
              <span class="badge text-[10px]">{tag}</span>
            ))}
          </div>
          <div class="mt-6 pt-5 border-t border-border-subtle flex items-center justify-between">
            <span class="text-xs text-text-muted">{details[svc.href].outcome}</span>
            <span class="text-primary-400 group-hover:text-primary-300 group-hover:translate-x-0.5 transition-all text-sm">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
