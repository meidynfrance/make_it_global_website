---
const cases = [
  {
    slug: 'agent-qualification-leads',
    sector: 'Services B2B',
    title: 'Agent de qualification de prospects',
    desc: 'Un assistant IA qui analyse chaque prospect entrant, l\'enrichit, le qualifie et pré-rédige le premier email. Connecté à HubSpot.',
    metrics: [
      { value: '78%', label: 'de prospects qualifiés automatiquement' },
      { value: '-22h', label: '/semaine' },
    ],
  },
  {
    slug: 'outil-metier-devis-sur-mesure',
    sector: 'Industrie',
    title: 'Outil de devis sur-mesure avec IA',
    desc: 'Application interne qui génère des devis techniques en analysant le cahier des charges client.',
    metrics: [
      { value: '4j → 20min', label: 'temps de devis' },
      { value: '+35%', label: 'taux de conversion' },
    ],
  },
  {
    slug: 'seo-programmatique-saas',
    sector: 'SaaS B2B',
    title: 'Référencement automatisé — 12 000 pages',
    desc: 'Génération automatisée de 12 000 pages ciblées, avec contrôle qualité IA + humain.',
    metrics: [
      { value: '+218%', label: 'trafic organique' },
      { value: '6 mois', label: 'pour atteindre le rythme de croisière' },
    ],
  },
];
---

<section class="relative py-24 sm:py-32" id="cas-clients">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-16">
      <div data-reveal="fade-up">
        <span class="badge">04 · Preuves</span>
        <h2 class="mt-6 text-4xl sm:text-5xl font-bold tracking-tight text-text-primary">
          Des projets <span class="gradient-text-accent">qui rapportent.</span>
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5" data-reveal-children="150">
      {cases.map((c) => (
        <div class="card p-8" data-reveal="fade-up">
          <span class="badge badge-primary text-[10px]">{c.sector}</span>
          <h3 class="mt-5 text-xl font-semibold text-text-primary tracking-tight leading-snug">{c.title}</h3>
          <p class="mt-3 text-sm text-text-muted leading-relaxed">{c.desc}</p>

          <div class="mt-6 pt-6 border-t border-border-subtle grid grid-cols-2 gap-4">
            {c.metrics.map((m) => (
              <div>
                <div class="text-2xl font-bold text-[#FF4F4F] tracking-tight">{m.value}</div>
                <div class="text-[11px] text-text-muted font-mono uppercase tracking-wider">{m.label}</div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
