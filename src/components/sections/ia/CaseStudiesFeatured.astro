---
const cases = [
  {
    slug: 'agent-qualification-leads',
    sector: 'Services B2B',
    title: 'Agent de qualification de leads',
    desc: 'Un agent IA qui analyse chaque lead entrant, l\'enrichit, le qualifie et pré-rédige le premier email. Branché à HubSpot.',
    metrics: [
      { value: '78%', label: 'leads qualifiés auto' },
      { value: '-22h', label: '/semaine' },
    ],
  },
  {
    slug: 'outil-metier-devis-sur-mesure',
    sector: 'Industrie',
    title: 'Outil de devis sur-mesure avec IA',
    desc: 'Application interne qui génère des devis techniques en analysant le cahier des charges client. Vectorisation + LLM.',
    metrics: [
      { value: '4j → 20min', label: 'temps de devis' },
      { value: '+35%', label: 'taux de closing' },
    ],
  },
  {
    slug: 'seo-programmatique-saas',
    sector: 'SaaS B2B',
    title: 'SEO programmatique 12 000 pages',
    desc: 'Génération pipeline de 12 000 pages ciblées, data-driven, avec contrôle qualité IA + humain. Sitemap dynamique.',
    metrics: [
      { value: '+218%', label: 'trafic organique' },
      { value: '6 mois', label: 'ramp-up' },
    ],
  },
];
---

<section class="relative py-24 sm:py-32" id="cas-clients">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-16">
      <div data-reveal="fade-up">
        <span class="badge">04 · Preuves</span>
        <h2 class="mt-6 text-4xl sm:text-5xl font-bold tracking-tight text-text-primary">
          Des projets <span class="gradient-text-accent">qui rapportent.</span>
        </h2>
      </div>
      <a href="/cas-clients/" class="btn-ghost text-sm self-end">Voir tous les cas →</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5" data-reveal-children="150">
      {cases.map((c) => (
        <a href={`/cas-clients/${c.slug}/`} class="card card-glow p-8 group" data-reveal="fade-up">
          <span class="badge badge-primary text-[10px]">{c.sector}</span>
          <h3 class="mt-5 text-xl font-semibold text-text-primary tracking-tight leading-snug">{c.title}</h3>
          <p class="mt-3 text-sm text-text-muted leading-relaxed">{c.desc}</p>

          <div class="mt-6 pt-6 border-t border-border-subtle grid grid-cols-2 gap-4">
            {c.metrics.map((m) => (
              <div>
                <div class="text-2xl font-bold gradient-text-accent tracking-tight">{m.value}</div>
                <div class="text-[11px] text-text-muted font-mono uppercase tracking-wider">{m.label}</div>
              </div>
            ))}
          </div>

          <div class="mt-6 text-primary-400 text-sm group-hover:translate-x-0.5 transition-transform">Lire le cas →</div>
        </a>
      ))}
    </div>
  </div>
</section>
