---
/**
 * MobileCTABar — Sticky CTA for mobile
 * Dark-tech variant: audit IA primary + booking secondary
 */
import { BOOKING_URL } from '../../config';
---

<div
  class="fixed bottom-0 left-0 right-0 z-50 lg:hidden glass-strong border-t border-border-subtle px-3 pt-3"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
  role="complementary"
  aria-label="Actions rapides"
>
  <div class="flex items-center gap-2">
    <a
      href={BOOKING_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-secondary flex-1 !py-3 !min-h-[48px] !text-sm"
      aria-label="Réserver un appel découverte"
    >
      Appel
    </a>
    <a
      href="/audit-ia/"
      class="btn-primary flex-[2] !py-3 !min-h-[48px] !text-sm"
      aria-label="Obtenir un audit IA gratuit"
    >
      Audit IA gratuit →
    </a>
  </div>
</div>
