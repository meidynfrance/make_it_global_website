---
import { SITE_NAME, NAV_SERVICES, BOOKING_URL, CONTACT_EMAIL } from '../../config';

const currentYear = new Date().getFullYear();
---

<footer class="relative border-t border-border-subtle bg-bg-base">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-500/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="inline-flex items-center gap-2 text-text-primary font-semibold tracking-tight">
          <span class="inline-block w-2 h-2 rounded-full bg-primary-500 shadow-[0_0_12px_#7C5CFF]"></span>
          {SITE_NAME}
        </a>
        <p class="mt-4 text-sm text-text-muted leading-relaxed max-w-xs">
          Agence d'implémentation IA pour PME et ETI. Outils métier, agents autonomes, automatisations, SEO.
        </p>
        <div class="mt-6 flex items-center gap-2">
          <span class="badge badge-accent badge-dot">Disponible</span>
        </div>
      </div>

      <!-- Services IA -->
      <div>
        <h3 class="text-[11px] font-mono uppercase tracking-wider text-text-dim mb-4">Services IA</h3>
        <ul class="space-y-2.5 text-sm">
          {NAV_SERVICES.map((svc) => (
            <li>
              <span class="text-text-muted">{svc.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Traduction (historique) -->
      <div>
        <h3 class="text-[11px] font-mono uppercase tracking-wider text-text-dim mb-4">Traduction & International</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/traduction/" class="text-text-muted hover:text-text-primary transition-colors">Notre métier historique</a></li>
          <li><a href="/blog/localisation/" class="text-text-muted hover:text-text-primary transition-colors">Blog Localisation</a></li>
          <li><a href="/traduction/" class="text-text-muted hover:text-text-primary transition-colors">Services de localisation</a></li>
        </ul>
      </div>

      <!-- Ressources & Contact -->
      <div>
        <h3 class="text-[11px] font-mono uppercase tracking-wider text-text-dim mb-4">Ressources</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/blog/" class="text-text-muted hover:text-text-primary transition-colors">Blog IA</a></li>
          <li><a href="/cas-clients/" class="text-text-muted hover:text-text-primary transition-colors">Cas clients</a></li>
          <li><a href="/audit-ia/" class="text-text-muted hover:text-text-primary transition-colors">Audit IA gratuit</a></li>
          <li><a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text-primary transition-colors">Réserver un appel</a></li>
          <li><a href={`mailto:${CONTACT_EMAIL}`} class="text-text-muted hover:text-text-primary transition-colors">{CONTACT_EMAIL}</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-14 pt-8 border-t border-border-subtle flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-text-dim">
      <p>&copy; {currentYear} {SITE_NAME}. Tous droits réservés.</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <a href="/mentions-legales/" class="hover:text-text-primary transition-colors">Mentions légales</a>
        <a href="/politique-de-confidentialite/" class="hover:text-text-primary transition-colors">Confidentialité</a>
        <a href="/cgu/" class="hover:text-text-primary transition-colors">CGU</a>
        <span class="opacity-60">EI Meidy BAFFOU · SIRET 80473268300045</span>
      </div>
    </div>
  </div>
</footer>
