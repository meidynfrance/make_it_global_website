---
/**
 * Button — Dark Tech variant system
 * WCAG AA: ≥48px touch targets, visible focus ring
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  href: string;
  ariaLabel?: string;
  class?: string;
  'data-section'?: string;
  target?: string;
  rel?: string;
}

const {
  variant = 'primary',
  href,
  ariaLabel,
  class: additionalClass,
  'data-section': dataSection,
  target,
  rel,
} = Astro.props;

const variantClass = {
  primary:   'btn-primary',
  secondary: 'btn-secondary',
  outline:   'btn-outline',
  ghost:     'btn-ghost',
}[variant];

const isExternal = href.startsWith('http://') || href.startsWith('https://');
const finalTarget = target ?? (isExternal ? '_blank' : undefined);
const finalRel = rel ?? (isExternal ? 'noopener noreferrer' : undefined);
---

<a
  href={href}
  class={`${variantClass} ${additionalClass || ''}`}
  aria-label={ariaLabel}
  target={finalTarget}
  rel={finalRel}
  data-section={dataSection}
>
  <slot />
</a>
