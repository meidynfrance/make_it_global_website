---
import BaseLayout from './BaseLayout.astro';
import DottedBg from '../components/ui/DottedBg.astro';
import { BOOKING_URL } from '../config';

interface Props {
  title: string;
  description: string;
  kicker: string;
  headline: string;
  subheadline: string;
  deliverables: Array<{ title: string; desc: string }>;
  process: Array<{ n: string; title: string; desc: string }>;
  faqs?: Array<{ q: string; a: string }>;
  relatedCase?: { slug: string; title: string; metric: string };
}

const {
  title,
  description,
  kicker,
  headline,
  subheadline,
  deliverables,
  process,
  faqs = [],
  relatedCase,
} = Astro.props;

// JSON-LD Service schema
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: headline,
  description: subheadline,
  provider: {
    '@type': 'Organization',
    name: 'Make It Global',
    url: 'https://makeitglobal-agency.com',
  },
  areaServed: { '@type': 'Country', name: 'France' },
  serviceType: kicker,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Livrables',
    itemListElement: deliverables.map((d, i) => ({
      '@type': 'Offer',
      position: i + 1,
      itemOffered: { '@type': 'Service', name: d.title, description: d.desc },
    })),
  },
};

// JSON-LD FAQPage (si faqs fournies)
const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const schemas = faqSchema ? [serviceSchema, faqSchema] : [serviceSchema];
---

<BaseLayout title={title} description={description} extraSchema={schemas}>
  <main id="main-content">
    <!-- Hero -->
    <section class="relative overflow-hidden pt-20 pb-20 sm:pt-28 sm:pb-24">
      <DottedBg variant="grid" />
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <a href="/" class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-text-primary transition-colors">
          ← Tous les services
        </a>
        <div class="mt-8 max-w-3xl" data-reveal="fade-up">
          <span class="badge badge-primary">{kicker}</span>
          <h1 class="mt-6 text-5xl sm:text-6xl font-bold tracking-tight text-text-primary leading-[1.05]">
            {headline}
          </h1>
          <p class="mt-6 text-lg sm:text-xl text-text-muted max-w-2xl leading-relaxed">
            {subheadline}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/audit-ia/" class="btn-primary">Obtenir un audit gratuit</a>
            <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">Réserver un appel</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Content slot -->
    <slot />

    <!-- Deliverables -->
    <section class="relative py-24 border-t border-border-subtle">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12" data-reveal="fade-up">
          <span class="badge">Livrables</span>
          <h2 class="mt-6 text-4xl font-bold tracking-tight text-text-primary">Ce que vous recevez.</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal-children="120">
          {deliverables.map((d, i) => (
            <div class="card p-6" data-reveal="fade-up">
              <div class="font-mono text-xs text-primary-400">{String(i + 1).padStart(2, '0')}</div>
              <h3 class="mt-4 text-lg font-semibold text-text-primary tracking-tight">{d.title}</h3>
              <p class="mt-2 text-sm text-text-muted leading-relaxed">{d.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="relative py-24 border-t border-border-subtle bg-bg-surface/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12" data-reveal="fade-up">
          <span class="badge">Comment ça se passe</span>
          <h2 class="mt-6 text-4xl font-bold tracking-tight text-text-primary">Notre process sur ce service.</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5" data-reveal-children="120">
          {process.map((p) => (
            <div class="card p-6" data-reveal="fade-up">
              <div class="font-mono text-2xl font-bold text-primary-400">{p.n}</div>
              <h3 class="mt-4 text-base font-semibold text-text-primary">{p.title}</h3>
              <p class="mt-2 text-sm text-text-muted leading-relaxed">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {relatedCase && (
      <section class="relative py-24 border-t border-border-subtle">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <a href={`/cas-clients/${relatedCase.slug}/`} class="card card-glow p-10 block group" data-reveal="fade-up">
            <span class="badge">Cas client</span>
            <div class="mt-6 flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6">
              <h3 class="text-3xl font-semibold text-text-primary tracking-tight max-w-xl">{relatedCase.title}</h3>
              <div class="shrink-0">
                <div class="text-4xl font-bold gradient-text-accent tracking-tight">{relatedCase.metric}</div>
              </div>
            </div>
            <div class="mt-6 text-primary-400 group-hover:translate-x-0.5 transition-transform">Lire le cas →</div>
          </a>
        </div>
      </section>
    )}

    {faqs.length > 0 && (
      <section class="relative py-24 border-t border-border-subtle">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-12" data-reveal="fade-up">
            <span class="badge">FAQ</span>
            <h2 class="mt-6 text-4xl font-bold tracking-tight text-text-primary">Questions fréquentes.</h2>
          </div>
          <div class="space-y-3" data-reveal-children="100">
            {faqs.map((faq) => (
              <details class="card p-6 cursor-pointer group" data-reveal="fade-up">
                <summary class="flex items-center justify-between list-none font-medium text-text-primary">
                  <span>{faq.q}</span>
                  <span class="text-primary-400 group-open:rotate-45 transition-transform text-xl font-light">+</span>
                </summary>
                <p class="mt-4 text-sm text-text-muted leading-relaxed">{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Final CTA -->
    <section class="relative py-24 border-t border-border-subtle">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl sm:text-5xl font-bold tracking-tight text-text-primary" data-reveal="fade-up">
          On attaque ?
        </h2>
        <p class="mt-6 text-lg text-text-muted" data-reveal="fade-up" data-reveal-delay="100">
          30 minutes suffisent pour voir si on peut vraiment vous aider. Audit 100% gratuit.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3" data-reveal="fade-up" data-reveal-delay="200">
          <a href="/audit-ia/" class="btn-primary">Obtenir mon audit IA</a>
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">Réserver un appel</a>
        </div>
      </div>
    </section>
  </main>

  <!-- GA4 custom event: service_page_view (fires once per page load on service pages) -->
  <script is:inline define:vars={{ kicker, headline }}>
    (function () {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', 'service_page_view', {
        service_kicker: kicker,
        service_name: headline,
        page_path: window.location.pathname,
      });
    })();
  </script>
</BaseLayout>
